# API
NODE_ENV=development
PORT=3001
EXTRACTION_TIMEOUT_MS=10000
EXTRACTION_MAX_HTML_BYTES=2097152
EXTRACTION_MAX_TEXT_CHARS=60000

# PostgreSQL (replace with your local or hosted database URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wanpanel?schema=public"

# Server-side AI configuration. Never expose these in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=45000
